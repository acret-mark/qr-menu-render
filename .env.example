# Postgres connection string. Local dev: a local Postgres database.
# Staging/production: the Render Postgres instance's connection string
# (specs/001-render-hosting-cutover).
DATABASE_URL=postgresql://user@localhost:5432/qr_menu_render_dev

# Auth.js session-signing secret. Generate with: openssl rand -base64 32
AUTH_SECRET=

NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Gmail SMTP (welcome email, password reset) — unchanged from qr-menu-dev.
GMAIL_SMTP_USER=
GMAIL_SMTP_APP_PASSWORD=

# Cloudinary (image CDN) — unchanged from qr-menu-dev.
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# Cron routes (payment reminders, subscription expiry) — unchanged from qr-menu-dev.
CRON_SECRET=
PAYMENT_REMINDER_THRESHOLD_DAYS=3

# AI descriptions / translation — unchanged from qr-menu-dev.
GEMINI_API_KEY=
ANTHROPIC_API_KEY=
AI_DESCRIPTION_DAILY_LIMIT=10
DEEPL_API_KEY=
